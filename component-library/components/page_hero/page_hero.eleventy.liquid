{%- comment -%}
  "Compact" is the short banner at the top of every Resources sub-page and the
  legal pages — a tag, a heading and one line, over the plain canvas. It is a
  different TREATMENT of the same content model, so it is a variant here rather
  than a second component (see ADDING_PAGES.md, "A variant, not a new
  component"). Its elements ship with `in` already on them: they are above the
  fold, and a hero that fades in after the observer runs reads as a flash.
{%- endcomment -%}
{% if variant == "holding" %}{% assign intro = false %}{% if animation == "intro" %}{% assign intro = true %}{% endif %}<section class="bk-hero bk-hero-about"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Hero" }}">
  {%- comment -%}
    A page that is not live yet. The headline is set one LETTER per <span>,
    because beckn.css runs the blue wave off `:nth-child` — ten written-out
    delays, no inline style and no script. Split on spaces first so the gap
    between words stays a text node and the span count keeps matching the
    delays; the whole word is on `aria-label`, and every span is hidden, so a
    screen reader reads "Coming soon" and not ten letters.
  {%- endcomment -%}
  <div class="bk-hero-body">
    {% if eyebrow %}
      <div class="bk-eyebrow{% unless intro %} bk-rv{% endunless %}"{% if intro %} data-bk-intro{% endif %}>{{ eyebrow }}</div>
    {% endif %}
    <h1 class="bk-soon-word{% unless intro %} bk-rv{% endunless %}"{% if heading_id %} id="{{ heading_id }}"{% endif %} aria-label="{{ heading }}"{% if intro %} data-bk-intro{% endif %}>{%- assign soon_words = heading | split: " " -%}{%- for soon_word in soon_words -%}{%- unless forloop.first %} {% endunless -%}{%- assign soon_letters = soon_word | split: "" -%}{%- for soon_letter in soon_letters -%}<span aria-hidden="true">{{ soon_letter }}</span>{%- endfor -%}{%- endfor -%}</h1>
    {% if status_label %}
      <p class="bk-hold-status bk-soon-status{% unless intro %} bk-rv{% endunless %}"{% if intro %} data-bk-intro{% endif %}>
        <svg class="bk-hold-node" width="180" height="20" viewBox="0 0 180 20" aria-hidden="true">
          <line x1="0" y1="10" x2="180" y2="10"></line>
          <circle class="bk-hold-node-dot" cx="90" cy="10" r="6"></circle>
        </svg>
        <span>{{ status_label }}</span>
      </p>
    {% endif %}
    {% for para in paragraphs %}
      <p class="bk-hero-sub{% unless intro %} bk-rv bk-rv-d1{% endunless %}"{% if intro %} data-bk-intro{% endif %}>{{ para.text }}</p>
    {% endfor %}
  </div>
</section>
{% elsif variant == "compact" %}<section class="hero hero-compact"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Hero" }}">
    <div class="hero-inner">
      <div class="container">
        {% if eyebrow %}<div class="hero-tag reveal in"><span class="dot"></span>{{ eyebrow }}</div>{% endif %}
        <h1 class="hero-h1 reveal d1 in"{% if heading_id %} id="{{ heading_id }}"{% endif %}>{{ heading }}{% if heading_accent %} <span>{{ heading_accent }}</span>{% endif %}{{ heading_suffix }}</h1>
        {% for para in paragraphs %}<p class="hero-sub reveal d2 in">{{ para.text }}</p>{% endfor %}
      </div>
    </div>
  </section>
{% else %}{% assign intro = false %}{% if animation == "intro" %}{% assign intro = true %}{% endif %}<section class="bk-hero bk-hero-about"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Hero" }}">
  {% if background_image %}
    <div class="bk-hero-photo" style="background-image: url('{{ background_image }}');" aria-hidden="true">
    </div>
    <div class="bk-hero-veil" aria-hidden="true">
    </div>
  {% endif %}
  <div class="bk-hero-body">
    {% if eyebrow %}
      <div class="bk-eyebrow{% unless intro %} bk-rv{% endunless %}"{% if intro %} data-bk-intro{% endif %}>{{ eyebrow }}</div>
    {% endif %}
    <h1{% if heading_id %} id="{{ heading_id }}"{% endif %}{% unless intro %} class="bk-rv"{% endunless %}{% if intro %} data-bk-intro{% endif %}>{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h1>
    {% for para in paragraphs %}
      <p class="bk-hero-sub{% unless intro %} bk-rv bk-rv-d1{% endunless %}"{% if intro %} data-bk-intro{% endif %}>{{ para.text }}</p>
    {% endfor %}
  </div>
  {% if buttons.size > 0 %}
    <div class="bk-hero-actions{% unless intro %} bk-rv bk-rv-d2{% endunless %}"{% if intro %} data-bk-intro{% endif %}>
      {% for button in buttons %}        <a
            class="bk-btn {% if button.style == "solid" %}bk-btn-solid{% else %}bk-btn-ghost{% endif %}"
            href="{{ button.url }}"{% if button.new_tab %} target="_blank"
            rel="noopener"{% endif %}>{{ button.label }}</a>
        {% endfor %}
    </div>
  {% endif %}
</section>
{% endif %}
