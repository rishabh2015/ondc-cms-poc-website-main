<section class="news">
  <div class="container">
    <div class="section-header">
      <h2>{{ title }}</h2>
      <p>{{ intro }}</p>
    </div>
    <div class="news-rail-wrap">
      <button aria-label="Previous" class="doors-arrow prev" type="button"><svg
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewbox="0 0 20 20"
          width="16"><path d="M13 4l-6 6 6 6"></path></svg></button><button aria-label="Next" class="doors-arrow next" type="button"><svg
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewbox="0 0 20 20"
          width="16"><path d="M7 4l6 6-6 6"></path></svg></button>
      <div aria-label="Press coverage — scroll horizontally" class="news-rail" role="region" tabindex="0">
        {% for card in cards %}<a
            class="news-card"
            href="{{ card.link }}"
            rel="noopener noreferrer"
            style="transition-delay: {{ forloop.index0 | times: 90 }}ms;"
            target="_blank">
            <div class="news-thumb">
              <div class="cms-img"><img alt="{{ card.headline }}" loading="lazy" src="{{ card.image }}"/></div>
              <div class="news-thumb-tag">{{ card.tag }}</div>
            </div>
            <div class="news-body">
              <div class="news-slug">
                <span class="news-slug-src">{{ card.source }}</span><span aria-hidden="true" class="news-slug-rule"></span><span aria-hidden="true" class="news-slug-no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              </div>
              <div class="news-headline">{{ card.headline }}</div>
              <div class="news-dek">{{ card.dek }}</div>
              <span class="news-cta">Read on {{ card.source }} <svg
                  fill="none"
                  height="12"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewbox="0 0 24 24"
                  width="12"><path d="M3 7h8M8 4l3 3-3 3"></path></svg></span>
            </div>
          </a>{% endfor %}{% assign card_count = cards | size %}{% assign more_delay = card_count | times: 90 %}{% if more.show %}<a
            class="news-card news-more"
            href="{{ more.url }}"
            rel="noopener noreferrer"
            style="transition-delay: {{ more_delay }}ms;"
            target="_blank">
            <div class="news-more-mark">
              <svg aria-hidden="true" fill="currentColor" viewbox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
            </div>
            <div class="news-more-label">{{ more.label }}</div>
            <div class="news-more-headline">{{ more.headline }}</div>
            <div class="news-more-dek">{{ more.dek }}</div>
            <span class="news-cta">{{ more.cta_label }} <svg
                fill="none"
                height="12"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewbox="0 0 24 24"
                width="12"><path d="M3 7h8M8 4l3 3-3 3"></path></svg></span></a>
        {% endif %}
      </div>
    </div>
  </div>
</section>