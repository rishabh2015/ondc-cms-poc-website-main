<section class="bk-panel bk-numbers"{% if anchor_id %} id="{{ anchor_id }}"{% endif %}{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Key numbers" }}">
  <div class="bk-numbers-head bk-rv">
    <h2{% if heading_id %} id="{{ heading_id }}"{% endif %}>{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h2>
    {% if as_of_note %}
      <p class="bk-note">{{ as_of_note }}</p>
    {% endif %}
  </div>
  {% for group in groups %}
    {% assign d = forloop.index %}
    {% if d > 2 %}
      {% assign d = 2 %}
    {% endif %}
    {% assign gid = "bk-statgrid-label-" | append: forloop.index %}
    {% if group.label %}
      <p class="bk-note bk-statgrid-label" id="{{ gid }}">{{ group.label }}</p>
    {% endif %}
    <div
      class="bk-statgrid{% if group.fit_to_content %} bk-statgrid-auto{% endif %} bk-rv bk-rv-d{{ d }}"
      role="group"{% if group.label %} aria-labelledby="{{ gid }}"{% endif %}>
      {% for tile in group.tiles %}
        <div class="bk-stat">
          <div class="bk-stat-fill" aria-hidden="true">
          </div>
          <div class="bk-stat-num">
            <b>{% if tile.count_up %}<span data-bk-count="{{ tile.value }}">{{ tile.value }}</span>{% else %}{{ tile.value }}{% endif %}</b>
          </div>
          <p class="bk-stat-desc">{{ tile.label }}</p>
        </div>
      {% endfor %}
    </div>
  {% endfor %}
  {% if legend.size > 0 %}
    <div class="bk-barriers bk-numbers-legend">
      {% for item in legend %}
        <div class="bk-barrier">
          <span class="bk-barrier-n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <span class="bk-barrier-t"><b>{{ item.term }}.</b> {{ item.desc }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>
