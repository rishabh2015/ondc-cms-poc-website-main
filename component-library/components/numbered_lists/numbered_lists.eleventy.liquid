{%- comment -%}
  Five layouts over one content model: a heading and an intro, then a list of
  points. What changes between them is the wrapper and how a point is drawn —
  whether it carries a counted number, a typed code, or neither.

    Panel / Our people  the original two, points are plain text
    Requirements        role pages, each point is a card with its own heading
    Relay               the Gateway's scroll-driven SEARCH / MULTICAST / DISCOVER
    Service lanes       the TSP continuum, the same band with counted numbers
    Outcomes            a plain stack of headed rows

  A field one layout ignores is normal here and not a sign of the wrong
  component: `code` is only drawn by Relay and by Requirements' node style.
{%- endcomment -%}
{% if variant == "relay" %}<section class="bk-relay"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-bk-relay data-screen-label="{{ screen_label | default: "How it works" }}"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %}>
    {%- comment -%}
      `data-bk-relay` is not decoration: beckn.js writes --bk-relay-progress on
      this element as it scrolls, which is what draws the line through the
      steps. Rename it and the relay goes static.
    {%- endcomment -%}
    <div class="bk-relay-head bk-rv">
      <h2{% if heading_id %} id="{{ heading_id }}"{% endif %} class="bk-h2">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h2>
      {% for paragraph in paragraphs %}<p>{{ paragraph.text }}</p>
      {% endfor %}
    </div>
    <div class="bk-relay-steps">
      {% for group in groups %}{% for item in group.items %}        <article class="bk-relay-step bk-rv">{% if item.code != blank %}<strong>{{ item.code }}</strong>{% endif %}{% if item.point_title != blank %}<h3>{{ item.point_title }}</h3>{% endif %}<p>{{ item.text }}</p></article>
      {% endfor %}{% endfor %}    </div>
  </section>
{% elsif variant == "service" %}<section class="bk-service-plane"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "How it works" }}"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %}>
    {%- comment -%}
      The same band as Relay, drawn as lanes: the marker here is a COUNTED
      number in a span rather than a typed code in a strong, so dragging a
      lane renumbers the rest. Written out rather than folded into Relay with
      a pile of assigns — the markup is the thing a reader comes here for.
    {%- endcomment -%}
    <div class="bk-service-plane-head bk-rv">
      <h2{% if heading_id %} id="{{ heading_id }}"{% endif %} class="bk-h2">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h2>
      {% for paragraph in paragraphs %}<p>{{ paragraph.text }}</p>
      {% endfor %}
    </div>
    <div class="bk-service-lanes">
      {% assign n = 0 %}
      {% for group in groups %}{% for item in group.items %}{% assign n = n | plus: 1 %}        <article class="bk-service-lane bk-rv"><span>{% if n < 10 %}0{% endif %}{{ n }}</span>{% if item.point_title != blank %}<h3>{{ item.point_title }}</h3>{% endif %}<p>{{ item.text }}</p></article>
      {% endfor %}{% endfor %}    </div>
  </section>
{% elsif variant == "outcomes" %}<section class="bk-role-outcomes"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "What it gives you" }}"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %}>
    <h2{% if heading_id %} id="{{ heading_id }}"{% endif %} class="bk-rv">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h2>
    <div class="bk-outcome-rows">
      {% for group in groups %}{% for item in group.items %}        <article class="bk-outcome-row bk-rv">{% if item.point_title != blank %}<h3>{{ item.point_title }}</h3>{% endif %}<p>{{ item.text }}</p></article>
      {% endfor %}{% endfor %}    </div>
  </section>
{% elsif variant == "role" %}<section class="bk-role-story"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "What this role must do" }}"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %}>
    <div class="bk-role-story-intro">
      <h2 class="bk-h2 bk-rv"{% if heading_id %} id="{{ heading_id }}"{% endif %}>{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}</h2>
      <div class="bk-role-story-copy bk-rv bk-rv-d1">
        {% for paragraph in paragraphs %}<p>{{ paragraph.text }}</p>
        {% endfor %}{% if lead_link.label != blank %}<a class="bk-ul" href="{{ lead_link.url }}"{% if lead_link.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ lead_link.label }}</a>
        {% endif %}
      </div>
    </div>
    {%- comment -%}
      Two ways the same points are shown. "Requirements" counts them and gives
      each a card in a flowing grid; "node types" is a two-up ledger where the
      marker is the node's CODE — MSN, ISN — typed on the point rather than
      counted, because it names the thing and is not a position.
    {%- endcomment -%}
    {% if list_style == "nodes" %}<div class="bk-node-ledger bk-rv"{% if aria_label %} aria-label="{{ aria_label }}"{% endif %}>
      {% for group in groups %}{% for item in group.items %}        <article class="bk-node">
          {% if item.code != blank %}<div class="bk-node-code" aria-hidden="true">{{ item.code }}</div>
          {% endif %}{% if item.point_title != blank %}<h3>{{ item.point_title }}</h3>
          {% endif %}<p>{{ item.text }}</p>
        </article>
      {% endfor %}{% endfor %}    </div>
    {% else %}<div class="bk-requirements"{% if aria_label %} aria-label="{{ aria_label }}"{% endif %}>
      {% assign n = 0 %}
      {% for group in groups %}{% for item in group.items %}{% assign n = n | plus: 1 %}        <article class="bk-requirement bk-rv">
          <span class="bk-requirement-number">{% if n < 10 %}0{% endif %}{{ n }}</span>
          {% if item.point_title != blank %}<h3>{{ item.point_title }}</h3>
          {% endif %}<p>{{ item.text }}</p>
        </article>
      {% endfor %}{% endfor %}    </div>
    {% endif %}
  </section>
{% elsif variant == "culture" %}<section class="bk-culture"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Our people" }}">
    <div class="bk-culture-lead">
      {% if eyebrow %}
        <div class="bk-eyebrow bk-rv">{{ eyebrow }}</div>
      {% endif %}
      <h2 class="bk-h2 bk-rv">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>
        {% endif %}</h2>
      {% if lead %}
        <p data-bk-scrub>{{ lead }}</p>
      {% endif %}
    </div>
    <div class="bk-barriers bk-rv bk-rv-d1">
      {% assign n = 0 %}
      {% for group in groups %}
        {% for item in group.items %}
          {% assign n = n | plus: 1 %}
          <div class="bk-barrier">
            <span class="bk-barrier-n">{% if n < 10 %}0{% endif %}{{ n }}</span>
            <span class="bk-barrier-t">{{ item.text }}</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </section>
{% else %}<section class="bk-panel bk-matters"{% if anchor_id %} id="{{ anchor_id }}"{% endif %} data-screen-label="{{ screen_label | default: "Why it matters" }}">
    <div class="bk-matters-grid">
      <div class="bk-reality-lead bk-rv">
        {% if eyebrow %}
          <div class="bk-eyebrow">{{ eyebrow }}</div>
        {% endif %}
        <h2 class="bk-h2">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>
          {% endif %}</h2>
        {% if lead %}
          <p>{{ lead }}</p>
        {% endif %}
      </div>
      <div>
        {% for group in groups %}
          <div class="bk-eyebrow{% unless forloop.first %} bk-matters-gap{% endunless %} bk-rv">{{ group.heading }}</div>
          {% if group.intro %}
            <p class="bk-matters-sub bk-rv">{{ group.intro }}</p>
          {% endif %}
          <div class="bk-barriers bk-rv bk-rv-d1">
            {% for item in group.items %}
              <div class="bk-barrier">
                <span class="bk-barrier-n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <p class="bk-barrier-t">{{ item.text }}</p>
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}