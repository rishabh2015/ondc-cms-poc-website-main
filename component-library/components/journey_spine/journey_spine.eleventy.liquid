<section
  class="bk-mech"
  id="{{ anchor_id | default: "bk-mech" }}"{% if heading_id %} aria-labelledby="{{ heading_id }}"{% endif %} data-screen-label="{{ screen_label | default: "How it works" }}">
  <div class="bk-mech-head bk-rv">
    <h2 class="bk-h2"{% if heading_id %} id="{{ heading_id }}"{% endif %}>{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>{% endif %}{{ heading_suffix }}</h2>
    {% if lead %}
      <p class="bk-hero-sub" style="margin-left:0">{{ lead }}</p>
    {% endif %}
  </div>

  <div class="bk-spine">
    <div class="bk-spine-track" aria-hidden="true">
    </div>
    <div class="bk-spine-fill" id="bk-spine-fill" aria-hidden="true">
    </div>
    <div>
      {% for step in steps %}
        <div class="bk-step bk-rv">
          <div class="bk-step-node" aria-hidden="true">
          </div>
          <div class="bk-step-ghost" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
          {% assign odd = forloop.index0 | modulo: 2 %}
          <div class="bk-step-body{% if odd == 1 %} bk-indent{% endif %}">
            <div class="bk-step-title">{{ step.title }}</div>
            <div class="bk-step-desc">{{ step.desc }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  {% if details.size > 0 %}
    <div class="bk-seat-ledger"{% if details_label %} aria-label="{{ details_label }}"{% endif %}>
      {% for item in details %}
        <details class="bk-seat" name="bk-detail"{% if forloop.first %} open{% endif %}>
          <summary class="bk-seat-row">
            <span class="bk-seat-node" aria-hidden="true"></span>
            <span class="bk-seat-title">{{ item.title }}</span>
          </summary>
          <div class="bk-seat-jd">
            {% if item.bullets.size > 0 %}
              <ul>
                {% for b in item.bullets %}
                  <li>{{ b.text }}</li>
                {% endfor %}
              </ul>
            {% endif %}{% if item.body %}            {{ item.body }}
            {% endif %}          </div>
        </details>
      {% endfor %}
    </div>
  {% endif %}
</section>
