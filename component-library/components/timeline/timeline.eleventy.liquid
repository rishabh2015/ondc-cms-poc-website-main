  <div class="bk-tl-stage">
    <canvas id="jnCanvas" aria-hidden="true"></canvas>
  </div>

  <div class="bk-tl-content">
    <div class="container">
      <div class="bk-tl-col">
        <div class="bk-tl-head bk-rv">
          {% if eyebrow %}
            <div class="bk-eyebrow">{{ eyebrow }}</div>
          {% endif %}
          <h2 class="bk-h2">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>
            {% endif %}</h2>
          {% if lead %}
            <p class="bk-tl-lead">{{ lead }}</p>
          {% endif %}
        </div>

        <ol class="bk-tl-years">
          {% for year in years %}
            <li class="bk-tl-year" id="y{{ year.year }}">
              <h3 class="bk-tl-yr bk-rv">{{ year.year }}</h3>
              <div class="bk-eyebrow bk-rv">{{ year.label }}</div>
              <ul class="bk-tl-entries">
                {% for entry in year.entries %}
                  {% if entry.is_milestone %}
                    <li class="bk-tl-beat bk-rv">
                      <span class="bk-tl-wash" aria-hidden="true"></span>
                      <div class="bk-tl-meta">{{ entry.meta }}</div>
                      {% if entry.milestone_number %}
                        <div class="bk-tl-beat-num">
                          <b>{{ entry.milestone_number }}</b><i>{{ entry.milestone_suffix }}</i>
                        </div>
                      {% else %}
                        <div class="bk-tl-beat-word">{{ entry.milestone_title }}</div>
                      {% endif %}
                      <p class="bk-tl-text">{{ entry.text }}</p>
                    </li>
                  {% else %}
                    <li class="bk-tl-entry bk-rv">
                      <div class="bk-tl-meta">{{ entry.meta }}</div>
                      <p class="bk-tl-text">{{ entry.text }}</p>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </li>
          {% endfor %}
        </ol>
        {% if finale.number %}
          <div class="bk-tl-finale bk-rv">
            <div class="bk-tl-finale-in" id="bk-tl-finale-in">
              <span class="bk-tl-wash" aria-hidden="true"></span>
              <div class="bk-tl-finale-num">
                <b><span data-bk-count="{{ finale.number }}">{{ finale.number }}</span></b><i>{{ finale.suffix }}</i>
              </div>
              <div class="bk-eyebrow">{{ finale.label }}</div>
              <p class="bk-tl-finale-line">{{ finale.text }}</p>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
