<section
  class="bk-inst"
  id="{{ anchor_id | default: "investor-relations" }}"
  data-screen-label="{{ screen_label | default: "Investor relations" }}">
  <div class="bk-inst-grid">
    <div class="bk-rv">
      {% if eyebrow %}
        <div class="bk-eyebrow">{{ eyebrow }}</div>
      {% endif %}
      <h2 class="bk-h2">{{ heading }}{% if heading_accent %} <em>{{ heading_accent }}</em>
        {% endif %}</h2>
      {% if lead %}
        <p class="bk-inst-copy">{{ lead }}</p>
      {% endif %}
    </div>
    <div class="bk-inst-rows bk-rv bk-rv-d1">
      {% for row in rows %}
        <div class="bk-inst-row">
          <div class="bk-eyebrow">{{ row.eyebrow }}</div>
          <div class="bk-inst-name">{{ row.name }}</div>
          <p class="bk-inst-desc">{{ row.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
  {% if logos.image %}
    <div class="bk-inst-logos bk-rv">
      <div class="bk-inst-logos-head">
        <div class="bk-eyebrow">{{ logos.heading }}</div>
        <div class="bk-inst-count">
          <b><span data-bk-count="{{ logos.count }}">{{ logos.count }}</span></b><i>{{ logos.count_label }}</i>
        </div>
      </div>
      <img src="{{ logos.image }}" alt="{{ logos.alt }}">
    </div>
  {% endif %}
</section>
